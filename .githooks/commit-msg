#!/bin/sh
# expectation-guard-source: OpenTouryoCodingAgentAssets@6a3d9f49bcc3 src/quality/ExpectationGuard/commit-msg sha256:b6bb16028ecf1267cce194860c59257cc99d4b6c1189f527125bb5b9331edc0b
# Expectation-change guard (stage 2. OpenTouryoCodingAgentAssets#3).
#   Rejects a commit that changes test expectations without an "Expectation-Change: <reason>" trailer
#   in the commit message. The detection itself is root/programs/CheckExpectationChange.ps1 (shared with the CI check);
#   what counts as an expectation is in the rules files next to it.
#
#   Enable : git config core.hooksPath .githooks
#   Note   : keep this file ASCII and LF. sh runs it on every platform.

root=$(git rev-parse --show-toplevel) || exit 1
script="$root/root/programs/CheckExpectationChange.ps1"

# Windows PowerShell 5.1 first (what users run on Windows), then PowerShell 7.
#   PSModulePath is dropped: when git runs from PowerShell 7, it points at the 7 modules first,
#   and 5.1 then fails to find some cmdlets. Both editions rebuild their own default.
if command -v powershell.exe >/dev/null 2>&1; then
    ps=powershell.exe
elif command -v pwsh >/dev/null 2>&1; then
    ps=pwsh
else
    echo "commit-msg: PowerShell not found; cannot check expectation changes." >&2
    exit 1
fi

env -u PSModulePath "$ps" -NoProfile -ExecutionPolicy Bypass -File "$script" -Staged -MessageFile "$1"
status=$?
if [ $status -ne 0 ]; then
    echo "commit-msg: rejected by CheckExpectationChange.ps1 (exit $status)." >&2
fi
exit $status
