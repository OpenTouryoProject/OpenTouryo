<?xml version="1.0"?>
<package >
  <metadata>
    <id>Erutcurtsarfni.Oyruot.Public</id>
    <title>NepoOyruot.Public</title>
    <version>$version$</version>
    <authors>OSS Consortium .net subcommittee</authors>
    <owners>daisukenishino77</owners>
    <license type="expression">Apache-2.0</license>
    <projectUrl>https://github.com/OpenTouryoProject/OpenTouryo/tree/master/root/programs/CS/Frameworks/Infrastructure/Public</projectUrl>
    <icon>_OpenTouryo.png</icon>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <summary>NuGet tests by OpenTouryoPJ.</summary>
    <description>This is to test everything from NuGet registration to using the debug server.</description>
    <releaseNotes>https://github.com/OpenTouryoProject/OpenTouryo/releases</releaseNotes>
    <copyright></copyright>
    <tags></tags>
    <!--Source Link で参照するソースの位置（#531）。
        commit は _T_NuGetPack.bat が渡す（$commit$）。-->
    <repository type="git" url="https://github.com/OpenTouryoProject/OpenTouryo" commit="$commit$" />
    <dependencies>
      <group targetFramework="net48">
        <dependency id="log4net" version="3.3.0" />
        <dependency id="Microsoft.Data.SqlClient" version="6.0.2" />
        <dependency id="Newtonsoft.Json" version="13.0.3" />
        <dependency id="NLog" version="5.5.0" />
      </group>
      <group targetFramework="net10.0">
        <dependency id="log4net" version="3.3.0" />
        <dependency id="Microsoft.Data.SqlClient" version="6.0.1" />
        <dependency id="Microsoft.Extensions.Configuration" version="9.0.4" />
        <dependency id="Microsoft.Extensions.Configuration.Binder" version="9.0.4" />
        <dependency id="Microsoft.Extensions.Configuration.FileExtensions" version="9.0.4" />
        <dependency id="Microsoft.Extensions.Configuration.Json" version="9.0.4" />
        <dependency id="Newtonsoft.Json" version="13.0.3" />
        <dependency id="NLog" version="5.5.0" />
        <dependency id="System.Data.Odbc" version="9.0.4" />
        <dependency id="Zipangu" version="1.1.8" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="_OpenTouryo.png" target="" />

    <file src="in\net48\OpenTouryo.Public.dll" target="lib\net48" />
    <file src="in\net48\OpenTouryo.Public.pdb" target="lib\net48" />
    <file src="in\net48\OpenTouryo.Public.xml" target="lib\net48" />
    <file src="in\net48\ja-JP\OpenTouryo.Public.resources.dll" target="lib\net48\ja-JP" />

    <file src="in\net10.0\OpenTouryo.Public.dll" target="lib\net10.0" />
    <file src="in\net10.0\OpenTouryo.Public.pdb" target="lib\net10.0" />
    <file src="in\net10.0\OpenTouryo.Public.xml" target="lib\net10.0" />
    <file src="in\net10.0\ja-JP\OpenTouryo.Public.resources.dll" target="lib\net10.0\ja-JP" />

  </files>
</package>
