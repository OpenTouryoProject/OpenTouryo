{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // connectionStrings section
  //
  // **パスワードが直に書いてあるのは、すぐ動かせるサンプルだからである。**
  // 実際の環境での渡し方は CONFIGURATION.md 9 節。
  "connectionStrings": {
    "ConnectionString_SQL": "Data Source=localhost;Initial Catalog=Northwind;User ID=sa;Password=seigi@123;Encrypt=false;",
    "ConnectionString_ODBC": "Dsn=odbc_test1",
    "ConnectionString_ODP": "User Id=SCOTT;Password=tiger;Data Source=localhost/XE;",
    "ConnectionString_MCN": "Server=localhost;Database=test;User Id=root;Password=seigi@123",
    "ConnectionString_NPS": "HOST=localhost;DATABASE=postgres;USER ID=postgres;PASSWORD=seigi@123;"
  },

  // appSettings section
  //
  // 下の C:/root/... は、このリポジトリを Windows に展開したときの配置である。
  // **別の環境へ移すときは、ここを書き換えずに環境変数で差し替える。**
  // 上書きの仕組みとパスの落とし穴は CONFIGURATION.md 3〜7 節。
  "appSettings": {
    // Webサービス用
    //"Azure": "MVC_Sample",

    // 本番向けの切り替え - start
    //
    // 既定はいずれも従来どおりの動作。**どれも「on にするだけ」では済まない**ので、
    // 有効にする前に CONFIGURATION.md 8 節を読むこと。

    // HTTP を HTTPS へリダイレクトするか（on / off）
    "UseHttpsRedirection": "off",
    // Cookie に Secure 属性を必ず付けるか（always / 空）
    "CookieSecurePolicy": "",
    // データ保護の鍵の置き場所（空なら既定）
    "DataProtectionKeyPath": "",
    // 転送ヘッダ（X-Forwarded-Proto / -For）を取り込むか（on / off）
    "UseForwardedHeaders": "off",
    // 信用する前段のアドレス（カンマ区切り。空なら範囲を制限しない）
    "ForwardedHeadersKnownProxies": "",

    // 本番向けの切り替え - end

    // フレームワークの使用するパラメータ - start
    // 基盤画面パス"
    "FxErrorScreenPath": "/Error/Index",
    // 共有情報定義へのパス
    "FxXMLSPDefinition": "C:/root/files/resource/Xml/SPDefinition.xml",
    // メッセージ定義へのパス
    "FxXMLMSGDefinition": "C:/root/files/resource/Xml/MSGDefinition.xml",
    // トランザクション制御定義へのパス
    "FxXMLTCDefinition": "C:/root/files/resource/Xml/TCDefinition.xml",
    // 名前解決定義へのパス
    "FxXMLTMInProcessDefinition": "C:/root/files/resource/Xml/TMInProcessDefinition.xml",

    // フレームワークの使用するパラメータ - end

    // 共通部品の使用するパラメータ - start

    // Log4Netのコンフィグファイルへのパス
    "FxLog4NetConfFile": "C:/root/files/resource/Log/SampleLogConf.xml",
    // 共通部品の使用するパラメータ - end
    // Ｄ層のパフォーマンスログ出力機能のon・off" "-->",
    "FxSqlTraceLog": "on",
    // Ｄ層のSQL文キャッシュ機能のon・off
    // 開発フェーズのことを考慮して、デフォルトoffに設定",
    "FxSqlCacheSwitch": "off",
    // Ｄ層のSQLロード時のエンコーディングを指定（shift_jis、utf-8.etc）
    "FxSqlEncoding": "utf-8",
    // Ｄ層のコマンド タイムアウト値を指定（秒）
    "FxSqlCommandTimeout": "30",
    // セッションタイムアウト検出機能のon・off
    "FxSessionTimeOutCheck": "on",
    // フレームワークが発行するCookie名の接頭辞（空なら付けない。同じホストに複数配備するときに分ける）
    "FxCookieNamePrefix": "",
    // 共通部品の使用するパラメータ - end

    // アプリケーションの使用するパラメータ - start

    // OAuth2, OIDC認証（外部ログイン）
    //   接続先は MPAS のスタブ（https://localhost:44310。Sample4SpRp/README.md の 2 節）。
    //   client_id・秘密・戻り先は、MPAS の雛形のクライアント（MVC_Sample）と 1 文字も違ってはならない。
    //   id_token の鍵は、SpRp_DiscoveryUri の jwks_uri から kid で引く（issuer は SpRp_Issuer と照合する）。
    "OAuth2AndOidcClientID": "f53469c17c5a432f86ce563b7805ab89",
    "OAuth2AndOidcSecret":   "cKdwJb6mRKVIJpGxEWjIC94zquQltw_ECfO-55p21YM",
    "SpRp_Issuer":            "https://localhost:44310",
    "SpRp_DiscoveryUri":     "https://localhost:44310/.well-known/openid-configuration",
    "SpRp_JwkSetUri":             "https://localhost:44310/jwkcerts",
    "SpRp_AuthRequestUri":   "https://localhost:44310/authorize",
    "SpRp_TokenRequestUri":  "https://localhost:44310/token",
    "SpRp_UserInfoUri":      "https://localhost:44310/userinfo",
    "SpRp_RedirectUri":      "https://localhost:44334/Home/OAuth2AuthorizationCodeGrantClient",
    "SpRp_RsaCerFilePath":   "C:/root/files/resource/X509/SHA256RSA_Server.cer",

    // SAML2 認証（外部ログイン）
    //   IdP の SSO の口と署名鍵は、メタデータから引く（entityID は SpRp_Saml2EntityId と照合する）。
    //   ACS は、MPAS の雛形のクライアント（MVC_Sample）の redirect_uri_saml と 1 文字も違ってはならない。
    //   AuthnRequest には SpRp_RsaPfxFilePath の鍵で署名する（テスト用の鍵）。
    "SpRp_Saml2MetadataUri": "https://localhost:44310/samlmetadata",
    "SpRp_Saml2EntityId":    "https://localhost:44310",
    "SpRp_Saml2AcsUri":      "https://localhost:44334/Home/Saml2AssertionConsumerService",
    "SpRp_RsaPfxFilePath":   "C:/root/files/resource/X509/SHA256RSA_Client.pfx",
    "SpRp_RsaPfxPassword":   "test",
    
    // SQLファイルファイル（フォルダ）へのパス
    "SqlTextFilePath": "C:/root/files/resource/Sql"

    // アプリケーションの使用するパラメータ - end
  }
}
