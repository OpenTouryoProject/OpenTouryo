<?xml version="1.0" encoding="utf-8" ?>
<!--
    コンテナ用の log4net 構成設定（#548）

    resource/Log/SampleLogConf.xml との違いは、出力先だけである。

      resource 側 : <param name="File" value="C:\root\files\resource\Log\ACCESS" />
      こちら      : <file type="log4net.Util.PatternString" value="%env{OT_LOG_ROOT}/ACCESS" />

    ＜なぜ別ファイルにするか＞
      ・resource は読み取り専用（ro）でマウントするため、そこへは書けない
      ・resource 側の出力先は Windows の絶対パスで、Linux では無効

    ＜なぜ %env{} なのか＞
      Open棟梁が展開するのは **設定ファイルのパス**（FxLog4NetConfFile）までで、
      **その中身は展開せず、log4net へそのまま渡す**。
      したがって中の変数は log4net の書式で書く必要がある。
      log4net では PatternString の %env{} がそれに当たり、
      <param name="File"> ではなく型付きの <file> で指定する。

      OT_LOG_ROOT は docker-compose.yml で与えている。
-->

<log4net debug="true">

    <!-- ローリング・ログファイル出力用アペンダ -->
    <appender name="ACCESS" type="log4net.Appender.RollingFileAppender">
        <file type="log4net.Util.PatternString" value="%env{OT_LOG_ROOT}/ACCESS" />
        <!-- ローリングの設定 -->
        <param name="StaticLogFileName" value="false" />
        <param name="RollingStyle" value="date " />
        <param name="DatePattern" value='"."yyyy-MM-dd".log"' />
        <!-- 書き込み時の設定（追加 or 上書き、出力エンコーディング） -->
        <param name="AppendToFile" value="true" />
        <encoding value="utf-8" />
        <!-- メッセージのフォーマット -->
        <layout type="log4net.Layout.PatternLayout">
            <param name="ConversionPattern" value="[%date{yyyy/MM/dd HH:mm:ss,fff}],[%-5level],[%thread],%message%newline" />
        </layout>
        <!-- フィルタ（範囲）の設定 -->
        <filter type="log4net.Filter.LevelRangeFilter">
            <levelMin value="DEBUG" />
            <levelMax value="FATAL" />
        </filter>
    </appender>

    <!-- ローリング・ログファイル出力用アペンダ -->
    <appender name="SQLTRACE" type="log4net.Appender.RollingFileAppender">
        <file type="log4net.Util.PatternString" value="%env{OT_LOG_ROOT}/SQLTRACE" />
        <!-- ローリングの設定 -->
        <param name="StaticLogFileName" value="false" />
        <param name="RollingStyle" value="date " />
        <param name="DatePattern" value='"."yyyy-MM-dd".log"' />
        <!-- 書き込み時の設定（追加 or 上書き、出力エンコーディング） -->
        <param name="AppendToFile" value="true" />
        <encoding value="utf-8" />
        <!-- メッセージのフォーマット -->
        <layout type="log4net.Layout.PatternLayout">
            <param name="ConversionPattern" value="[%date{yyyy/MM/dd HH:mm:ss,fff}],[%-5level],[%thread],%message%newline" />
        </layout>
        <!-- フィルタ（範囲）の設定 -->
        <filter type="log4net.Filter.LevelRangeFilter">
            <levelMin value="DEBUG" />
            <levelMax value="FATAL" />
        </filter>
    </appender>

    <!-- ローリング・ログファイル出力用アペンダ -->
    <appender name="OPERATION" type="log4net.Appender.RollingFileAppender">
        <file type="log4net.Util.PatternString" value="%env{OT_LOG_ROOT}/OPERATION" />
        <!-- ローリングの設定 -->
        <param name="StaticLogFileName" value="false" />
        <param name="RollingStyle" value="date " />
        <param name="DatePattern" value='"."yyyy-MM-dd".log"' />
        <!-- 書き込み時の設定（追加 or 上書き、出力エンコーディング） -->
        <param name="AppendToFile" value="true" />
        <encoding value="utf-8" />
        <!-- メッセージのフォーマット -->
        <layout type="log4net.Layout.PatternLayout">
            <param name="ConversionPattern" value="[%date{yyyy/MM/dd HH:mm:ss,fff}],[%-5level],[%thread],%message%newline" />
        </layout>
        <!-- フィルタ（範囲）の設定 -->
        <filter type="log4net.Filter.LevelRangeFilter">
            <levelMin value="DEBUG" />
            <levelMax value="FATAL" />
        </filter>
    </appender>

    <root>
    </root>

    <logger name="ACCESS">
        <level value="All" />
        <appender-ref ref="ACCESS" />
    </logger>
    <logger name="SQLTRACE">
        <level value="All" />
        <appender-ref ref="SQLTRACE" />
    </logger>
    <logger name="OPERATION">
        <level value="All" />
        <appender-ref ref="OPERATION" />
    </logger>
</log4net>
