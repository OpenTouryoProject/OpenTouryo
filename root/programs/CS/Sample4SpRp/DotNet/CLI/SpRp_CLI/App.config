<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- **値は appsettings.json（net10.0）と同じにする**（意味は ../../README.md の 3 節） -->
    <add key="SpRp_Issuer" value="https://localhost:44310" />
    <add key="SpRp_DiscoveryUri" value="https://localhost:44310/.well-known/openid-configuration" />
    <add key="SpRp_RedirectUri" value="http://localhost:12345/" />
    <add key="SpRp_Scope" value="openid profile email" />
    <add key="OAuth2AndOidcClientID" value="ae5a179813234ca290c8de93ef2e31dc" />

    <!-- cc・jwtbearer・ropc（サーバで動くバッチを模したコンフィデンシャル クライアント。../../README.md の 4 節） -->
    <add key="SpRp_BatchClientID" value="b9582fe575bf4ba9984f3fc81147408c" />
    <add key="SpRp_BatchClientSecret" value="RLVKAIIrbMO9pRCPBbv899IZtJ87EajfVWR9AhfD5a4" />
    <add key="SpRp_BatchScope" value="profile email" />
    <add key="SpRp_RsaPfxFilePath" value="C:/root/files/resource/X509/SHA256RSA_Client.pfx" />
    <add key="SpRp_RsaPfxPassword" value="test" />
  </appSettings>
</configuration>
