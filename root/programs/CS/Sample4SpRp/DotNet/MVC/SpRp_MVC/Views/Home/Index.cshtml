@{
    // フローを選ぶ画面（#668）。リンクは Fapi1Controller.Start・Fapi2Controller.Start へ行く。
    //   { コントローラ, flow, responseMode, 表示 }
    string[][] flows = new string[][]
    {
        new string[] { "Fapi1", "oauth2", "",          "FAPI1 : code（openid なし）＋ private_key_jwt" },
        new string[] { "Fapi1", "oidc",   "",          "FAPI1 : code ＋ OIDC ＋ private_key_jwt" },
        new string[] { "Fapi1", "oidc",   "query.jwt", "FAPI1 : code ＋ OIDC ＋ private_key_jwt、JARM（query.jwt）" },
        new string[] { "Fapi1", "pkce",   "",          "FAPI1 : code ＋ OIDC ＋ PKCE（S256）" },
        new string[] { "Fapi1", "pkce",   "query.jwt", "FAPI1 : code ＋ OIDC ＋ PKCE（S256）、JARM（query.jwt）" },
        // FAPI2（#668 の追加。MPAS の自己テストの FAPI2 のうち、CIBA を除くもの。par_mtls は StubCompose.ps1 -Mtls のスタブで通る）
        new string[] { "Fapi2", "par",    "",          "FAPI2 : PAR ＋ private_key_jwt ＋ PKCE（S256）" },
        new string[] { "Fapi2", "par",    "query.jwt", "FAPI2 : PAR ＋ private_key_jwt ＋ PKCE（S256）、JARM（query.jwt）" },
        new string[] { "Fapi2", "ros",    "",          "FAPI2 : Request Object を /ros に預ける ＋ private_key_jwt ＋ PKCE（S256）" },
        new string[] { "Fapi2", "ros",    "query.jwt", "FAPI2 : Request Object を /ros に預ける ＋ private_key_jwt ＋ PKCE（S256）、JARM（query.jwt）" },
        new string[] { "Fapi2", "par_mtls", "",          "FAPI2 : PAR ＋ tls_client_auth（MTLS）＋ PKCE（S256）" },
        new string[] { "Fapi2", "par_mtls", "query.jwt", "FAPI2 : PAR ＋ tls_client_auth（MTLS）＋ PKCE（S256）、JARM（query.jwt）" },
    };
}
<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="utf-8" />
    <title>SpRp_MVC</title>
</head>
<body>
    <h1>SpRp_MVC（FAPI 1.0・2.0 のクライアント）</h1>
    <p>IdP は MPAS のスタブ。クライアントの登録は Sample4SpRp\Stub\Sample4SpRp.stub.json（README の 5 節）。</p>
    <ul id="flows">
        @foreach (string[] f in flows)
        {
            <li><a href="@Url.Action("Start", f[0], new { flow = f[1], responseMode = f[2] })">@f[3]</a></li>
        }
    </ul>
</body>
</html>
