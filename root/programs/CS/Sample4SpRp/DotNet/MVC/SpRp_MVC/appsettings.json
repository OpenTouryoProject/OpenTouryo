{
  // SpRp_MVC の設定（#668）。**キーは部品が読むもの**（CmnClientParams・OAuth2AndOIDCParams）。
  //   **IdP の登録（..\..\..\Stub\Sample4SpRp.stub.json）と、1 文字も違ってはならない。**
  "appSettings": {
    // ---- 相手（IdP = MPAS のスタブ）
    //   エンドポイントと jwks_uri は、Discovery から引く（issuer は SpRp_Issuer と照合する）。
    "SpRp_Issuer": "https://localhost:44310",
    "SpRp_DiscoveryUri": "https://localhost:44310/.well-known/openid-configuration",

    // ---- 自分（IdP に登録したクライアント。client_mode = fapi1）
    //   oauth2・oidc の flow（private_key_jwt）と、pkce の flow（秘密なし。サンプル独自のキー）で、クライアントを分ける。
    //   **private_key_jwt を登録したクライアントは、PKCE だけでは引き換えられない**（コンフィデンシャル）。
    "OAuth2AndOidcClientID": "75d74cb5a4ae44e3afec154623f0cbb4",
    "SpRp_Fapi1PkceClientID": "9e53bded5e7d4ee4bc9e7e30f7a9f0a6",
    "SpRp_RedirectUri": "https://localhost:44336/Fapi1/Callback",

    //   FAPI2（client_mode = fapi2。par・ros の flow。private_key_jwt）。サンプル独自のキー（#668 の追加）。
    //   **戻り先も FAPI1 と分ける**（別の登録なので、IdP が照合する redirect_uri も別）。
    "SpRp_Fapi2ClientID": "0cb517873cca4afd86098316373eaffc",
    "SpRp_Fapi2RedirectUri": "https://localhost:44336/Fapi2/Callback",

    //   求める scope（サンプル独自のキー）。oauth2 の flow は openid を含めない。
    "SpRp_Scope": "openid profile email",
    "SpRp_Fapi1OAuth2Scope": "profile email",

    //   private_key_jwt の署名鍵（**テスト用の鍵**。IdP には、その公開鍵を登録してある）。FAPI2 の Request Object の署名にも使う。
    "SpRp_RsaPfxFilePath": "C:/root/files/resource/X509/SHA256RSA_Client.pfx",
    "SpRp_RsaPfxPassword": "test"
  },

  // **待ち受けは、IdP に登録した戻り先と同じ URL にする**（launchSettings.json に頼らない）
  "Kestrel": {
    "Endpoints": {
      "Https": { "Url": "https://localhost:44336" }
    }
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
