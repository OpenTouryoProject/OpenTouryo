<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!--
      このクライアントは CallController を経由しない。
      WebAPI を HTTP で直接叩き、DTO（DTTables）の往復だけを見る（#570）。
      そのため、通信制御の名前解決定義（TMProtocolDefinition.xml）は要らない。
    -->
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
