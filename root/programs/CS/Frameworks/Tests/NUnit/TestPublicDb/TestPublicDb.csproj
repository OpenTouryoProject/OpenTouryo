<Project Sdk="Microsoft.NET.Sdk">

  <!--Dam（データ アクセス）の単体テスト。**DB に接続する**（#610）。
      TestPublic と分けているのは、DB を前提にするため（Golden の TestCode / TestDataAccess と同じ理由）。
      混ぜると、DB が無い環境で TestPublic ごと動かなくなる。

      SQL Server は必須（CI でも接続する）。Oracle / MySQL / PostgreSQL は、
      接続できなければスキップする（LocalServicesOnDocker を起動していれば走る）。-->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TestPublicDb</RootNamespace>
    <!--TestPublic と同じ理由（Assert.Throws のラムダ）。-->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <!--データ プロバイダは Golden の TestDataAccess と同じ版にそろえる。
      **net48 の SqlClient は PackageReference で入れる。** HintPath の DLL だけでは
      ネイティブの SNI が配置されず、接続時に DllNotFoundException になる（TESTING.md 2 節）。-->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.2" />
    <!--SqlClient 6.0.2 が引く Pkcs 8.0.1 に既知の脆弱性があるため、修正版へ引き上げる。-->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="MySql.Data" Version="9.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess" Version="23.8.0" />
    <Reference Include="System.Configuration" />
    <Reference Include="OpenTouryo.Public">
      <HintPath>..\..\..\Infrastructure\Build_net48\OpenTouryo.Public.dll</HintPath>
    </Reference>
    <Reference Include="OpenTouryo.DamManagedOdp">
      <HintPath>..\..\..\Infrastructure\Build_net48\OpenTouryo.DamManagedOdp.dll</HintPath>
    </Reference>
    <Reference Include="OpenTouryo.DamMySQL">
      <HintPath>..\..\..\Infrastructure\Build_net48\OpenTouryo.DamMySQL.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="log4net" Version="3.3.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <!--SqlClient 7.0.0 が引く Pkcs 9.0.13 に既知の脆弱性があるため、修正版へ引き上げる。-->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <PackageReference Include="MySql.Data" Version="9.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="9.0.3" />
    <!--Oracle は .NET 版のパッケージ名が違う（Golden の TestDataAccessCore と同じ）。-->
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.8.0" />
    <Reference Include="OpenTouryo.Public">
      <HintPath>..\..\..\Infrastructure\Build_netcore100\net10.0\OpenTouryo.Public.dll</HintPath>
    </Reference>
    <Reference Include="OpenTouryo.DamManagedOdp">
      <HintPath>..\..\..\Infrastructure\Build_netcore100\net10.0\OpenTouryo.DamManagedOdp.dll</HintPath>
    </Reference>
    <Reference Include="OpenTouryo.DamMySQL">
      <HintPath>..\..\..\Infrastructure\Build_netcore100\net10.0\OpenTouryo.DamMySQL.dll</HintPath>
    </Reference>
    <!--DamPstGrS は .NET 専用。-->
    <Reference Include="OpenTouryo.DamPstGrS">
      <HintPath>..\..\..\Infrastructure\Build_netcore100\net10.0\OpenTouryo.DamPstGrS.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
