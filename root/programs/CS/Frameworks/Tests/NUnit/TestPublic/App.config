<?xml version="1.0" encoding="utf-8"?>
<!-- net48 のテスト用の構成（#610）。.NET は TestSetup.cs で同じ値を与える。 -->
<configuration>
  <appSettings>
    <!-- LogIF のテスト（Logging/LogIFTests.cs）が使う log4net の構成 -->
    <add key="FxLog4NetConfFile" value="NUnitLogConf.xml" />
    <!-- GetConfigParameter のテスト（Util/GetConfigParameterTests.cs）が読む値 -->
    <add key="NUnitKey" value="NUnitValue" />
  </appSettings>
  <connectionStrings>
    <!-- GetConfigParameter のテストが読む値（接続はしない） -->
    <add name="NUnitConn" connectionString="Data Source=nunit;Initial Catalog=x;" />
  </connectionStrings>
</configuration>
