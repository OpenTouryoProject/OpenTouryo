<Project Sdk="Microsoft.NET.Sdk">

  <!--NUnit による Public 層の単体テスト（#610）。
      Golden の TestCode と違い、net48 / net10.0 を 1 つの csproj でマルチ ターゲットにする。
      テスト コードは共通で、TFM ごとの差は #if NETCOREAPP で書き分ける。-->
  <PropertyGroup>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>TestPublic</RootNamespace>
    <!--net48 の既定（C# 7.3）では、NUnit 4 の Assert.Throws(() => ...) が
        TestDelegate と Action の間で曖昧になる。新しい言語版なら Action 側に決まる。
        言語機能だけの話で、ランタイムの機能は使わない。-->
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.0" />
    <!--カバレッジの収集は net10.0 だけで行う（y_Build_TestCode_NUnit.bat）。-->
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
  </ItemGroup>

  <!--フレームワークは HintPath で参照する（Golden と同じ）。
      → **フレームワークを先にビルドしないと、古い DLL を見る。**
      HintPath では NuGet の推移的依存が効かないため、
      Public が使うパッケージは、テストで通る範囲だけここにも並べる。-->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="OpenTouryo.Public">
      <HintPath>..\..\..\Infrastructure\Build_net48\OpenTouryo.Public.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <!--StringConverter（全角・半角、かな変換）が使う。-->
    <PackageReference Include="Zipangu" Version="1.1.8" />
    <!--DTTables の JSON 化が使う。net48 は Build_net48 の DLL が複写されるので要らない。-->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!--ZipperV2 / UnZipperV2 が使う。-->
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
    <!--GetConfigParameter.InitConfiguration に渡す構成（TestSetup.cs）。-->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <!--LogIF が使う（NLog は LogLib=nlog のときだけ読まれるので並べない）。-->
    <PackageReference Include="log4net" Version="3.3.0" />
    <!--DamSqlSvr が使う（Db のテストは接続しない。SqlCommand を作るだけ）。-->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.0" />
    <Reference Include="OpenTouryo.Public">
      <HintPath>..\..\..\Infrastructure\Build_netcore100\net10.0\OpenTouryo.Public.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--LogIF のテストが使う log4net の構成（FxLog4NetConfFile）。-->
    <None Update="NUnitLogConf.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
