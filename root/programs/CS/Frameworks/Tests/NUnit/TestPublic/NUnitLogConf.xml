<?xml version="1.0" encoding="utf-8" ?>
<!-- LogIF の単体テスト用の log4net 構成（#610）。
     FxLog4NetConfFile で指定する（net48 は App.config、.NET は TestSetup.cs）。
     出力先の相対パスは、log4net が実行フォルダ（BaseDirectory）基準で解決する。 -->
<log4net>

  <!-- INFO 以上 -->
  <appender name="NUNIT_INFO" type="log4net.Appender.FileAppender">
    <param name="File" value="NUnitLog/NUNIT_INFO.log" />
    <param name="AppendToFile" value="false" />
    <!-- テストが書き込み中のファイルを読むため、書くときだけ開く -->
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <param name="ConversionPattern" value="[%-5level],%message%newline" />
    </layout>
  </appender>

  <!-- WARN 以上 -->
  <appender name="NUNIT_WARN" type="log4net.Appender.FileAppender">
    <param name="File" value="NUnitLog/NUNIT_WARN.log" />
    <param name="AppendToFile" value="false" />
    <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
    <layout type="log4net.Layout.PatternLayout">
      <param name="ConversionPattern" value="[%-5level],%message%newline" />
    </layout>
  </appender>

  <logger name="NUNIT_INFO">
    <level value="INFO" />
    <appender-ref ref="NUNIT_INFO" />
  </logger>

  <logger name="NUNIT_WARN">
    <level value="WARN" />
    <appender-ref ref="NUNIT_WARN" />
  </logger>

</log4net>
