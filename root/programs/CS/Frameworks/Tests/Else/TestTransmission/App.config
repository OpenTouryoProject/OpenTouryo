<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- 呼び出しプロトコルの名前解決定義（テスト専用） -->
    <add key="FxXMLTMProtocolDefinition" value="TMProtocolDefinition.xml" />
  </appSettings>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <!-- テストのホスト側（NetTcpBinding(SecurityMode.None)）と揃える -->
        <binding name="NetTcpBinding_NoSec">
          <security mode="None" />
        </binding>
      </netTcpBinding>
    </bindings>
    <client>
      <!-- name は FxLiteral.WCF_TCPIP_ENDPOINT_CONFIGNAME と一致させる。
           address は CallController が定義XMLの url で上書きするため空でよい。 -->
      <endpoint name="Touryo.Infrastructure.Business.Transmission.WCFTCPSvcForFx"
                address=""
                binding="netTcpBinding"
                bindingConfiguration="NetTcpBinding_NoSec"
                contract="Touryo.Infrastructure.Framework.Transmission.IWCFTCPSvcForFx" />
    </client>
  </system.serviceModel>
</configuration>
