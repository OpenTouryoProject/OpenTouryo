<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Touryo.Infrastructure.Framework</RootNamespace>
    <AssemblyName>OpenTouryo.Framework</AssemblyName>
    <Version>$(OpenTouryoVersion)</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\Build_netcore100\</OutputPath>
    <DocumentationFile>..\Build_netcore100\net10.0\OpenTouryo.Framework.xml</DocumentationFile>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);NETSTD</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\Build_netcore100\</OutputPath>
    <DocumentationFile>..\Build_netcore100\net10.0\OpenTouryo.Framework.xml</DocumentationFile>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <DefineConstants>$(DefineConstants);NETSTD</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="RichClient\**" />
    <EmbeddedResource Remove="RichClient\**" />
    <None Remove="RichClient\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Presentation\BaseController.cs" />
    <Compile Remove="Presentation\BaseMasterController.cs" />
    <Compile Remove="Presentation\BaseMVController.cs" />
    <Compile Remove="Presentation\FxEventArgs.cs" />
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <Compile Remove="Transmission\IWCFTCPSvcForFx.cs" />
    <Compile Remove="Util\FxHttpQueryStringIndex.cs" />
    <Compile Remove="Util\FxSessionUtil.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="app.config" />
  </ItemGroup>

  <!--処理区分ごとに分けた partial クラスのファイルを、IDE で本体の下に並べる（ビルドには影響しない）。
      本体 X.cs の区分は X.＜区分＞.cs の名前で置く。区分のファイルを足しても、ここは書き換えなくてよい。
      net48 は Framework_net48.csproj の Compile Include に、ファイルごとに DependentUpon を付けている。-->
  <ItemGroup>
    <Compile Update="Authentication\OAuth2AndOIDCClient.*.cs">
      <DependentUpon>OAuth2AndOIDCClient.cs</DependentUpon>
    </Compile>
    <Compile Update="Authentication\SAML2Client.*.cs">
      <DependentUpon>SAML2Client.cs</DependentUpon>
    </Compile>
    <Compile Update="Authentication\SAML2Bindings.*.cs">
      <DependentUpon>SAML2Bindings.cs</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Http.Extensions" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.Session" Version="2.3.0" />
    <PackageReference Include="Microsoft.Extensions.PlatformAbstractions" Version="1.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Public\Public_netcore100.csproj" />
    <ProjectReference Include="..\Public\Security\Public.Security_netcore100.csproj" />
  </ItemGroup>

</Project>
